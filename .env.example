PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
BACKEND_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# GitHub OAuth (login) + Sponsors API (active sponsor check)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_SPONSOR_LOGIN=zsevic
GITHUB_SPONSOR_CHECK_TOKEN=your-github-pat-with-sponsorship-read
# Optional; when set, only sponsors on this tier get access (from sponsorsListing.tiers.nodes[].id)
# GITHUB_SPONSOR_REQUIRED_TIER_ID=ST_...
# Optional; default is ${BACKEND_ORIGIN}/api/auth/github/callback
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
SPONSOR_CHECK_CACHE_TTL_SECONDS=300

DATABASE_URL=postgres://jobradar:jobradar@localhost:5433/jobradar
# Set to true to skip migrations on boot (e.g. some test runners). Omit or false = run migrations before listen.
SKIP_DB_MIGRATIONS=
# Set to true to skip source catalog upsert on boot. Omit or false = upsert sources after migrations.
SKIP_SOURCE_SEED=
REDIS_URL=redis://localhost:6379

# Mailtrap (local) — https://mailtrap.io → Email Testing → SMTP credentials
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=JobRadar <noreply@jobradar.tech>
EMAIL_DIGEST_INTERVAL_MINUTES=15
EMAIL_DIGEST_MAX_JOBS=25
SOURCE_POLLING_INTERVAL_MINUTES=30
